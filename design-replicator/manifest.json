{
  "manifest_version": 3,
  "name": "Design Replicator",
  "version": "1.4.0",
  "description": "Sayfaları ve görselleri HTML/CSS/JS tasarımına dönüştürün. Binbir Dizayn kütüphanesi ve ücretli Pro uyarlama araçları.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Design Replicator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "unlimitedStorage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "replicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Aktif sekmeyi tasarıma dönüştür"
    }
  },
  "sandbox": {
    "pages": [
      "sandbox/preview.html",
      "sandbox/target-picker.html"
    ]
  },
  "version_name": "1.4.0 — Pro görsel hedef seçimi"
}
